{
  "name": "redline-crm-server",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --persist-to=./.wrangler/state",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply redline-crm-preview --local",
    "db:migrate:preview": "wrangler d1 migrations apply redline-crm-preview --remote",
    "db:migrate:production": "wrangler d1 migrations apply redline-crm --remote --env production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
